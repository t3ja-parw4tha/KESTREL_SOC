# Platform
SOC_PLATFORM_URL=http://localhost:8000
SECRET_KEY=your-secret-key-here
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./soc_platform.db

# AI Providers (at least one required)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Azure / Microsoft Sentinel
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
LOGANALYTICS_WORKSPACE_ID=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Threat Intel
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Notifications
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Observability
JAEGER_HOST=localhost
JAEGER_PORT=6831
SERVICE_VERSION=1.0.0

# Grafana (required - no default)
GRAFANA_PASSWORD=
