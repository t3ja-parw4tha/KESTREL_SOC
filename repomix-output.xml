STATUS_MAP = {
    "open": AlertStatus.OPEN, "new": AlertStatus.OPEN, "in_progress": AlertStatus.IN_PROGRESS,
    "resolved": AlertStatus.RESOLVED, "false_positive": AlertStatus.FALSE_POSITIVE,
}


