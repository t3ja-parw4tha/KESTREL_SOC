          {% for t in (mitre_items[:3] if mitre_items else []) %}
          <span class="inline-block rounded px-1 py-0.5 text-xs bg-soc-border text-soc-muted mr-0.5">{{ t.get('technique_id', '') if t is mapping else t }}</span>
