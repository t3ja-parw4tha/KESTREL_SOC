<file path="frontend/templates/mitre.html">
{% extends "base.html" %}
{% block title %}MITRE Coverage - SOC Platform{% endblock %}
{% block content %}
<div class="space-y-4" x-data="{ selectedTechnique: null }">
  <h1 class="text-2xl font-semibold text-soc-text">MITRE ATT&CK Coverage</h1>

  <div class="rounded-lg border border-soc-border bg-[#181a21] p-4 inline-block">
    <p class="text-soc-muted text-sm"><span class="text-soc-text font-medium">{{ summary.techniques_detected }}</span> techniques covered · <span class="text-soc-text font-medium">{{ summary.coverage_percentage }}%</span> coverage</p>
