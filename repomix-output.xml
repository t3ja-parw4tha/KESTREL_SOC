        )}

        {tab === 'raw' && (
          <div>
            <button type="button" onClick={handleCopyRaw} className="mb-2 inline-flex items-center gap-1 px-2 py-1 rounded border border-soc-border text-soc-muted hover:text-soc-text text-sm">
              <Copy className="w-4 h-4" /> Copy
            </button>
