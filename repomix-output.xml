        <input type="text" name="search" x-model="search" placeholder="Search title" class="rounded border border-soc-border bg-soc-bg text-soc-text px-3 py-1.5 text-sm w-48"
               hx-get="/alerts/table" hx-target="#alerts-table-wrap" hx-include="#alerts-filter-form" hx-trigger="keyup changed delay:300ms"/>
      </div>
      <input type="hidden" name="page" value="1" />
      <input type="hidden" name="limit" value="20" />
    </div>
  </div>

  <div id="alerts-table-wrap" class="rounded-lg border border-soc-border bg-[#181a21] p-4 overflow-x-auto"
       hx-get="/alerts/table?page=1&limit=20"
       hx-trigger="load"
       hx-swap="innerHTML">
    <p class="text-soc-muted">Loading alerts...</p>
  </div>
</div>
{% endblock %}
</file>

<file path="frontend/templates/base.html">
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}SOC Platform{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            soc: {
              bg: '#0f1117',
              surface: '#181a21',
              border: '#2d3139',
              text: '#e4e6eb',
              muted: '#9ca3af',
              critical: '#ef4444',
              high: '#f97316',
              medium: '#eab308',
              low: '#3b82f6',
              safe: '#22c55e',
            }
