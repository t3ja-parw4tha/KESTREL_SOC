      </div>
      {% else %}
      <p class="text-soc-muted text-sm">No MITRE techniques.</p>
      {% endfor %}
    </div>

    <div x-show="tab === 'timeline'" x-cloak style="display: none;">
      <p class="text-soc-muted text-sm">Load timeline via API /alerts/{{ alert.id }}/timeline</p>
    </div>

    <div x-show="tab === 'raw'" x-cloak style="display: none;">
      <pre class="text-xs text-soc-muted overflow-auto max-h-[400px] bg-soc-bg p-3 rounded">{{ (alert.raw or {}) | tojson(indent=2) }}</pre>
