      <td class="py-2 pr-2 text-soc-muted">{{ a.status.value if a.status else '-' }}</td>
      <td class="py-2 pr-2 text-soc-muted">{{ a.assigned_to or '-' }}</td>
      <td class="py-2 text-soc-muted">{{ a.created_at.strftime('%Y-%m-%d %H:%M') if a.created_at else '-' }}</td>
    </tr>
    {% else %}
    <tr><td colspan="9" class="py-6 text-soc-muted text-center">No alerts match filters.</td></tr>
    {% endfor %}
  </tbody>
  {% if total is defined and limit %}
  <tfoot>
    <tr class="border-t border-soc-border">
      <td colspan="9" class="py-2 text-soc-muted text-sm">
        Page {{ page }} of {{ ((total + limit - 1) // limit) or 1 }} ({{ total }} total)
        {% set max_page = ((total + limit - 1) // limit) or 1 %}
        {% if page > 1 %}
        <a href="#" class="ml-2 text-blue-400 hover:underline" hx-get="/alerts/table?page={{ page - 1 }}&severity={{ request.query_params.get('severity','') }}&status={{ request.query_params.get('status','') }}&source={{ request.query_params.get('source','') }}&search={{ request.query_params.get('search','') }}&limit={{ limit }}" hx-target="#alerts-table-wrap" hx-swap="innerHTML">Prev</a>
        {% endif %}
        {% if page < max_page %}
        <a href="#" class="ml-2 text-blue-400 hover:underline" hx-get="/alerts/table?page={{ page + 1 }}&severity={{ request.query_params.get('severity','') }}&status={{ request.query_params.get('status','') }}&source={{ request.query_params.get('source','') }}&search={{ request.query_params.get('search','') }}&limit={{ limit }}" hx-target="#alerts-table-wrap" hx-swap="innerHTML">Next</a>
        {% endif %}
      </td>
    </tr>
  </tfoot>
  {% endif %}
</table>
</file>

